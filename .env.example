# LLM providers — at least one required.
# Tried in order: Gemini → Groq → DeepSeek (rate-limit / 5xx / validation
# failure on one falls through to the next).
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=                # optional — gsk_... from console.groq.com/keys
DEEPSEEK_API_KEY=            # optional — sk-... from platform.deepseek.com/api_keys
# Per-provider model overrides (defaults shown):
# GEMINI_MODEL=gemini-flash-lite-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# DEEPSEEK_MODEL=deepseek-chat

# PocketBase (PocketHost)
POCKETBASE_URL=https://easyreview.pockethost.io
POCKETBASE_ADMIN_EMAIL=your-admin-email
POCKETBASE_ADMIN_PASSWORD=your-admin-password

# Wiki repo for brief writeback (D)
WIKI_GITHUB_OWNER=your-github-username
WIKI_GITHUB_REPO=SEO-GEO-B-M-Wiki
WIKI_GITHUB_PAT=ghp_your_fine_scoped_pat_with_contents_write_on_wiki_repo_only
WIKI_GITHUB_BRANCH=main

# v1-only (leave blank in v0):
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENCRYPTION_KEY=
